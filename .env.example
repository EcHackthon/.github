# Gemini configuration
GEMINI_MODEL=gemini-1.5-pro-latest
GEMINI_PROMPT_PATH=prompts/primary_prompt.txt
GEMINI_TEMPERATURE=0.9
GEMINI_TOP_P=0.95
# optional: path to your Gemini CLI profile
# GEMINI_PROFILE_PATH=~/.config/gemini/profiles/default.json

# Spotify credentials (use hackathon owner account)
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REFRESH_TOKEN=your_long_lived_refresh_token
SPOTIFY_USER_ID=your_spotify_user_id
# optional curated playlist for fallback recommendations
# SPOTIFY_RECOMMENDATION_PLAYLIST_ID=playlist_id

# Backend integration
# BACKEND_RECOMMENDATION_ENDPOINT=https://your-backend/api/recommendations
# BACKEND_API_KEY=your_backend_api_key

# Environment configuration
APP_ENV=development
